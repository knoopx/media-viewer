{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "main.tsx",
    "App.tsx",
    "theme.ts",
    "config.ts",
    "lib/**/*.ts",
    "components/**/*.tsx"
  ]
}
